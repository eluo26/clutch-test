# Copy to .env at the repo root. Every variable is optional -- the defaults
# run a working app against the bundled sample data.

# --- security ---------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the default value when CLUTCH_ENV=production.
CLUTCH_SECRET_KEY=dev-only-insecure-change-me
CLUTCH_ENV=dev
CLUTCH_ACCESS_TOKEN_TTL_MINUTES=720
CLUTCH_MIN_PASSWORD_LENGTH=10

# --- storage ----------------------------------------------------------------
# SQLite by default. Postgres works too, but the sandboxed query runner used by
# the text-to-SQL layer is SQLite-specific -- for Postgres, point it at a role
# with SELECT-only grants instead.
# CLUTCH_DATABASE_URL=sqlite:///./clutch.db

# --- text-to-SQL ------------------------------------------------------------
# Without a key the API falls back to a deterministic rule-based provider that
# answers a handful of common questions. Everything else still works.
# CLUTCH_ANTHROPIC_API_KEY=sk-ant-...
CLUTCH_ANTHROPIC_MODEL=claude-sonnet-4-5
CLUTCH_NLQ_ROW_LIMIT=500
CLUTCH_NLQ_RATE_LIMIT_PER_MINUTE=10

# --- Java simulation service ------------------------------------------------
# Optional. If it is not running, the API uses the pure-Python solver.
CLUTCH_SIM_SERVICE_URL=http://127.0.0.1:8081

# --- CORS -------------------------------------------------------------------
CLUTCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
